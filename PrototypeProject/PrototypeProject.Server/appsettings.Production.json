{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=heatmap.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.SignalR": "Trace",
      "Microsoft.AspNetCore.Http.Connections": "Trace",
      "Microsoft.AspNetCore.Routing": "Debug"
    }
  },
  "AllowedHosts": "*"
}