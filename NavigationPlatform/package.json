{
  "config": {
    "swaggerInput": "Swagger/swagger.json",
    "apiOutput": "navigationplatform.client/src/api",
    "clientOutput": "navigationplatform.client",
    "serverOutput": "NavigationPlatform.Server"
  },
  "dependencies": {
    "open": "^11.0.0",
    "prettier": "^3.8.2",
    "react-icons": "^5.6.0",
    "react-router": "^7.13.1",
    "react-toastify": "^11.0.5",
    "swagger-typescript-api": "^13.6.10"
  },
  "scripts": {
    "dev": "node Scripts/Node/dev.mjs",
    "dev:no": "node Scripts/Node/dev.mjs --no",
    "stop": "node Scripts/Node/stop.mjs",
    "swagger": "node Scripts/Node/swagger.mjs && npm run stop",
    "generate:ts-api": "swagger-typescript-api generate -p %npm_package_config_swaggerInput% -o %npm_package_config_apiOutput% --modular --module-name-first-tag --fetch --extractRequestParams --templates swagger-templates && node Scripts/JS/convertFilesArrayToFormdata.js ",
    "create:api-instance": "node Scripts/JS/createApiInstance.js && npm run prettier",
    "generate:api": "node Scripts/Node/swagger.mjs && npm run generate:api-minimal && npm run stop",
    "generate:api-minimal": "npm run generate:ts-api && npm run create:api-instance",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
